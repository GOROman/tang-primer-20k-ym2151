IO_LOC "clk" H11;
IO_LOC "PA_EN" R16;
IO_LOC "HP_DIN" P15;
IO_LOC "HP_WS" P16;
IO_LOC "HP_BCK" N15;
IO_LOC "rst_n" T3;
IO_LOC "vol_down_n" T2;
IO_LOC "vol_up_n" D7;
IO_LOC "wav_trig_n" C7;
IO_LOC "led[0]" L16;
IO_LOC "led[1]" L14;
IO_LOC "led[2]" N14;
IO_LOC "led[3]" N16;
IO_LOC "O_tmds_clk_p" G16,H15;
IO_LOC "O_tmds_data_p[0]" H14,H16;
IO_LOC "O_tmds_data_p[1]" J15,K16;
IO_LOC "O_tmds_data_p[2]" K14,K15;

IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "vol_down_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "vol_up_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "wav_trig_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "O_tmds_clk_p" PULL_MODE=NONE DRIVE=3.5;
IO_PORT "O_tmds_data_p[0]" PULL_MODE=NONE DRIVE=3.5;
IO_PORT "O_tmds_data_p[1]" PULL_MODE=NONE DRIVE=3.5;
IO_PORT "O_tmds_data_p[2]" PULL_MODE=NONE DRIVE=3.5;
